# ============================================================
# Image Gen Studio 环境配置模板
#
# 使用：复制本文件为 .env 并填写真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交到版本库。
# 所有项也可用同名环境变量覆盖（环境变量优先级高于 .env）。
# ============================================================

# ---------- 云端服务器连接（deploy.sh / setup-server.sh 用）----------
# AutoDL 实例的 SSH 入口。换实例 / 换机器时这三项通常会变（尤其 SSH_PORT）。
SERVER_HOST=              # 例：region-41.seetacloud.com
SSH_PORT=                 # 例：53278
SSH_USER=root
# root 密码（或用 SSH key 免密后留空）
SSH_PASSWORD=

# ---------- 后端 API 访问（webui / code/client 用）----------
# 本机 SSH 隧道入口；若后端公网可达可改成 http://<服务器>:8080
API_BASE=http://localhost:8080
# nginx Basic Auth 账号（通常不用改）
API_USER=comfy
# nginx Basic Auth 密码；setup-server.sh 会把它同步写入服务器
API_PASSWORD=

# ---------- 服务器端路径（deploy.sh / setup-server.sh 用）----------
# AutoDL 上保持默认即可；换到其它 Linux 服务器时按需修改。
REMOTE_DIR=/root/image-service
PYTHON_BIN=/root/miniconda3/bin/python
DATA_DIR=/root/autodl-tmp
